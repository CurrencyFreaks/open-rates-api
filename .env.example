# Copy to .env and change the password: cp .env.example .env
POSTGRES_PASSWORD=change-me-to-a-long-random-password

# Host ports (change if busy on your machine)
FRANKFURTER_PORT=8081
# 127.0.0.1 = only this machine, 0.0.0.0 = reachable from the internet
BIND_ADDR=127.0.0.1
PG_PORT=5433

POSTGRES_VERSION=18
WORKER_PROCESSES=2
IMAGE_TAG=local
