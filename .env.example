# Copy to .env and fill in: cp .env.example .env
# Which database to use (required). Laptop: ..._dev, production server: currency_provider_data
DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/currency_provider_data_dev

# API host port (change if busy on your machine)
FRANKFURTER_PORT=8081
# 127.0.0.1 = only this machine, 0.0.0.0 = reachable from the internet
BIND_ADDR=127.0.0.1

WORKER_PROCESSES=2
IMAGE_TAG=local
